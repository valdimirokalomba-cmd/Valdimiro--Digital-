<!DOCTYPE html><html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Valdimiro Music | Distribuição Musical</title><meta name="description" content="Valdimiro Music — distribuição musical para artistas independentes. Envie a sua música e prepare o seu lançamento para plataformas digitais.">
<meta name="keywords" content="Valdimiro Music, distribuição musical, música, artistas, Spotify, YouTube Music, Apple Music, Deezer">
<meta name="theme-color" content="#080808"><style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#070707;
  color:#fff;
  line-height:1.6;
}

a{
  color:inherit;
  text-decoration:none;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#080808;
  border-bottom:1px solid #222;
  padding:15px 6%;
}

.navbar{
  max-width:1200px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.logo{
  font-size:24px;
  font-weight:bold;
}

.logo span{
  color:#1db954;
}

nav{
  display:flex;
  flex-wrap:wrap;
  gap:18px;
}

nav a{
  font-size:14px;
  color:#ddd;
}

nav a:hover{
  color:#1db954;
}

.hero{
  min-height:85vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:70px 6%;
  background:linear-gradient(135deg,#070707,#111);
}

.hero-content{
  max-width:850px;
}

.hero h1{
  font-size:clamp(40px,7vw,76px);
  line-height:1.05;
  margin-bottom:22px;
}

.hero h1 span{
  color:#1db954;
}

.hero p{
  color:#bbb;
  font-size:18px;
  margin-bottom:30px;
}

.buttons{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:14px;
}

.btn{
  display:inline-block;
  padding:14px 24px;
  border-radius:8px;
  font-weight:bold;
  transition:.2s;
}

.btn-primary{
  background:#1db954;
  color:#000;
}

.btn-secondary{
  border:1px solid #444;
  color:#fff;
}

.btn:hover{
  transform:translateY(-2px);
}

section{
  padding:75px 6%;
}

.container{
  max-width:1200px;
  margin:auto;
}

.section-title{
  text-align:center;
  margin-bottom:45px;
}

.section-title h2{
  font-size:38px;
  margin-bottom:10px;
}

.section-title p{
  color:#aaa;
}

.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.card{
  background:#101010;
  border:1px solid #252525;
  border-radius:14px;
  padding:28px;
}

.card h3{
  margin-bottom:12px;
  font-size:22px;
}

.card p{
  color:#aaa;
  margin-bottom:18px;
}

.price{
  font-size:32px;
  font-weight:bold;
  margin:15px 0 20px;
}

.price small{
  font-size:14px;
  color:#aaa;
}

.card ul{
  list-style:none;
  margin-bottom:22px;
}

.card li{
  padding:7px 0;
  color:#ccc;
}

.platforms{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

.platform{
  background:#101010;
  border:1px solid #252525;
  padding:20px;
  border-radius:10px;
  text-align:center;
  font-weight:bold;
}

.steps{
  counter-reset:step;
}

.step{
  background:#101010;
  border:1px solid #252525;
  border-radius:12px;
  padding:22px;
  margin-bottom:15px;
}

.step strong{
  color:#1db954;
}

.form-box{
  max-width:800px;
  margin:auto;
  background:#101010;
  border:1px solid #252525;
  padding:30px;
  border-radius:15px;
  text-align:center;
}

.blog{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.blog article{
  background:#101010;
  border:1px solid #252525;
  padding:25px;
  border-radius:14px;
}

.blog article h3{
  margin-bottom:12px;
}

.blog article p{
  color:#aaa;
}

.faq{
  max-width:850px;
  margin:auto;
}

details{
  background:#101010;
  border:1px solid #252525;
  padding:18px;
  margin-bottom:12px;
  border-radius:10px;
}

summary{
  cursor:pointer;
  font-weight:bold;
}

.contact{
  text-align:center;
}

footer{
  background:#050505;
  border-top:1px solid #222;
  padding:35px 6%;
  text-align:center;
  color:#888;
}

.whatsapp{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:999;
  background:#25d366;
  color:#000;
  padding:14px 18px;
  border-radius:50px;
  font-weight:bold;
  box-shadow:0 5px 20px #000;
}

@media(max-width:850px){
  .grid,
  .blog{
    grid-template-columns:1fr;
  }

  .platforms{
    grid-template-columns:repeat(2,1fr);
  }

  .navbar{
    flex-direction:column;
  }

  nav{
    justify-content:center;
  }
}

@media(max-width:500px){
  section{
    padding:55px 5%;
  }

  .platforms{
    grid-template-columns:1fr;
  }
}
</style></head><body><header>
